{
  "name": "pact-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run check:deployment && node scripts/build-info.mjs && node scripts/build-replay.mjs --check && tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "evidence:check": "node scripts/build-replay.mjs --check",
    "check:deployment": "node --test scripts/vercel-entrypoint.test.cjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vercel/python-analysis": "0.15.3",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.0"
  }
}
