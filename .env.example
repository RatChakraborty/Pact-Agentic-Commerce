# Copy to .env locally; NEVER commit .env
APP_ENV=development
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX_BUYER_EMAIL=
PAYPAL_SANDBOX_SELLER_EMAIL=
LLM_API_KEY=
LLM_MODEL=
# Server-side only secrets
APP_SESSION_SECRET=

# Local server settings
DATABASE_PATH=pact.db
# Limits reserve whole negotiation allowances before live API calls.
LLM_MAX_CALLS=12
LLM_MAX_TOKENS=600
LLM_BUDGET_USD=2.0
# Conservative configurable price estimates, not a provider billing guarantee.
LLM_INPUT_USD_PER_MILLION=20
LLM_OUTPUT_USD_PER_MILLION=120
LLM_MAX_INPUT_BYTES=12000

# Hosted private demo only: set all together; local defaults need none of these.
SECURE_COOKIES=false
PUBLIC_ORIGIN=
APP_ACCESS_PASSWORD=

# Anonymous hosted demo (Vercel injects VERCEL=1 automatically).
# Use a NEW dedicated database, never Nautilus's connection or generic DATABASE_URL.
PUBLIC_DEMO=false
PACT_DATABASE_URL=
ENABLE_LIVE_OPERATIONS=false
